# Supabase Postgres connection string
# (Supabase → Project Settings → Database → Connection string → URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

NODE_ENV=development
PORT=3000

# Auth (day one = phone + password)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging (push notifications) — a Firebase service account.
# Leave unset in dev: NotificationsService no-ops sends (logs a warning) but
# the rest of the feature (in-app notifications, read state) still works.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Later phases (leave unset until then):
# OTP_PROVIDER_KEY=        # Phase 9  — OTP login
# GOOGLE_MAPS_API_KEY=     # Phase 9  — maps navigation

# Dev-only: pre-provisioned seed accounts (phone + password)
SEED_ADMIN_PHONE=+10000000001
SEED_TECHNICIAN_PHONE=+10000000002
