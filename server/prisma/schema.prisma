// Prisma schema — AI Insemination Management Platform
// Domain models are introduced module-by-module per docs/phases.md.
// Phase 1: connection. Phase 2: auth (User, RefreshToken). Phase 4: master data.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; the rhel target is the engine Vercel's serverless
  // runtime (Amazon Linux, OpenSSL 3) needs — required or queries fail on deploy.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime: Supabase connection POOLER (port 6543, ?pgbouncer=true) — serverless
  // opens many short-lived connections, so pooling is required.
  url       = env("DATABASE_URL")
  // Migrations/introspection need a DIRECT connection (port 5432).
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  FARMER
  TECHNICIAN
}

enum Species {
  CATTLE
  GOAT
}

enum FertilityRating {
  LOW
  MEDIUM
  HIGH
}

enum AnimalBreedingStatus {
  OPEN
  INSEMINATED
  PREGNANT
  CALVED
}

enum BookingStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationEvent {
  BOOKING_ASSIGNED
  BOOKING_STARTED
  BOOKING_COMPLETED
  ADMIN_BROADCAST
}

model User {
  id           String   @id @default(cuid())
  phone        String
  role         Role
  name         String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Farmer profile (address/district — technician sees this to find the farmer).
  address    String?
  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  // Technician profile (coverage area, used to filter the admin's assign picker).
  serviceAreaId String?
  serviceArea   ServiceArea? @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)

  refreshTokens        RefreshToken[]
  animals              Animal[]
  bookingsAsFarmer     Booking[]      @relation("BookingFarmer")
  bookingsAsTechnician Booking[]      @relation("BookingTechnician")
  deviceTokens         DeviceToken[]
  notifications        Notification[]

  @@unique([phone, role])
  @@map("users")
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  role       Role
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, role])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Breed {
  id        String   @id @default(cuid())
  species   Species
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sires   SireCatalogue[]
  animals Animal[]

  @@unique([species, name])
  @@map("breeds")
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  contact   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sires SireCatalogue[]

  @@map("organizations")
}

model District {
  id        String   @id @default(cuid())
  name      String
  state     String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceAreas ServiceArea[]
  farmers      User[]

  @@unique([state, name])
  @@map("districts")
}

model ServiceArea {
  id         String   @id @default(cuid())
  name       String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  technicians User[]

  @@unique([districtId, name])
  @@index([districtId])
  @@map("service_areas")
}

model SireCatalogue {
  id              String          @id @default(cuid())
  species         Species
  name            String
  breedId         String
  breed           Breed           @relation(fields: [breedId], references: [id], onDelete: Restrict)
  organizationId  String?
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  fertilityRating FertilityRating
  diseaseFree     Boolean         @default(true)
  strawPriceMinor Int
  isAvailable     Boolean         @default(true)
  imageUrl        String?
  imagePublicId   String?

  // Cattle (Bull) specific
  geneticScore       Float?
  milkYieldPotential Int?
  fatPct             Float?

  // Goat (Buck) specific
  growthIndex Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches Batch[]

  @@index([species])
  @@index([breedId])
  @@map("sire_catalogue")
}

model Batch {
  id                String        @id @default(cuid())
  sireId            String
  sire              SireCatalogue @relation(fields: [sireId], references: [id], onDelete: Cascade)
  batchNumber       String
  producedOn        DateTime?
  notes             String?
  quantityTotal     Int           @default(0)
  quantityAvailable Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  bookings Booking[]

  @@unique([sireId, batchNumber])
  @@index([sireId])
  @@map("batches")
}

model Animal {
  id             String               @id @default(cuid())
  farmerId       String
  farmer         User                 @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  species        Species
  breedId        String?
  breed          Breed?               @relation(fields: [breedId], references: [id], onDelete: SetNull)
  // Free-text breed, for farmers who don't know the exact registered breed or
  // whose breed isn't in the master list. Mutually exclusive with breedId.
  breedOther     String?
  tag            String
  ageMonths      Int?
  breedingStatus AnimalBreedingStatus @default(OPEN)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  bookings        Booking[]
  breedingHistory BreedingHistory[]

  @@unique([farmerId, tag])
  @@index([farmerId])
  @@map("animals")
}

model Booking {
  id            String        @id @default(cuid())
  animalId      String
  animal        Animal        @relation(fields: [animalId], references: [id], onDelete: Restrict)
  farmerId      String
  farmer        User          @relation("BookingFarmer", fields: [farmerId], references: [id], onDelete: Restrict)
  batchId       String
  batch         Batch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  technicianId  String?
  technician    User?         @relation("BookingTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  status        BookingStatus @default(PENDING)
  preferredDate DateTime
  // Where this particular visit should happen. Defaults to the farmer's
  // profile address in the app, but can differ per booking (another shed,
  // a relative's farm, …) — this is what the technician actually travels to.
  location      String?
  notes         String?
  assignedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  serviceNotes  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  breedingHistory BreedingHistory?

  @@index([farmerId])
  @@index([animalId])
  @@index([batchId])
  @@index([technicianId])
  @@index([status])
  @@map("bookings")
}

model BreedingHistory {
  id               String   @id @default(cuid())
  animalId         String
  animal           Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inseminationDate DateTime
  notes            String?
  createdAt        DateTime @default(now())

  @@index([animalId])
  @@map("breeding_history")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

model AppSettings {
  id                String   @id @default(cuid())
  lowStockThreshold Int      @default(10)
  supportPhone      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("app_settings")
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     NotificationEvent
  title     String
  body      String
  bookingId String?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([userId, readAt])
  @@map("notifications")
}
