// Prisma schema — AI Insemination Management Platform
// Domain models are introduced module-by-module per docs/phases.md.
// Phase 1 establishes the connection only; no domain models yet.
// Phase 2 adds: Role, User, RefreshToken (phone + password auth).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
